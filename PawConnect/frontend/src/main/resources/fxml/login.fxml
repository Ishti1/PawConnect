<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Pos?>

<HBox fx:id="rootPane"
      styleClass="login-page"
      stylesheets="@../styles/app.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.catconnect.controller.LoginController">

    <!-- LEFT 60% -->
    <BorderPane prefWidth="900"
                maxWidth="Infinity"
                HBox.hgrow="ALWAYS"
                styleClass="login-pink-side">
        <top>
            <HBox alignment="TOP_LEFT" style="-fx-padding: 20;">
                <ImageView fitHeight="120" preserveRatio="true">
                    <image>
                        <Image url="@../images/pawconnect_logo.png"/>
                    </image>
                </ImageView>
            </HBox>
        </top>
        <center>
            <VBox alignment="CENTER" spacing="22">
                <StackPane prefWidth="400" prefHeight="280"
                   translateY="-50" styleClass="login-story-stack">

            <ImageView fitWidth="160" fitHeight="220"
                       preserveRatio="true"
                       rotate="-10"
                       translateX="-120"
                       translateY="10"
                       styleClass="story-image">
                <image>
                    <Image url="@../images/login_img.jpg"/>
                </image>
            </ImageView>

            <ImageView fitWidth="160" fitHeight="220"
                       preserveRatio="true"
                       rotate="8"
                       translateX="120"
                       translateY="20"
                       styleClass="story-image">
                <image>
                    <Image url="@../images/login_img2.jpeg"/>
                </image>
            </ImageView>

            <ImageView fitWidth="200" fitHeight="280"
                       preserveRatio="true"
                       styleClass="story-image-front">
                <image>
                    <Image url="@../images/login_img4.jpeg"/>
                </image>
            </ImageView>

        </StackPane>

        <Label text="PaWConnect"
               styleClass="login-brand"/>

        <Label text="Connect with people who love cats"
               wrapText="true"
               styleClass="login-tagline"/>

        <Label text="Find care • Share moments • Help cats"
               wrapText="true"
               styleClass="login-subtitle"/>

            </VBox>
        </center>
    </BorderPane>

    <!-- RIGHT 40% -->
    <VBox alignment="CENTER"
          prefWidth="700"
          maxWidth="Infinity"
          HBox.hgrow="ALWAYS"
          styleClass="login-white-side">

        <VBox alignment="CENTER"
              spacing="18"
              maxWidth="520"
              styleClass="login-form-card">

            <Label text="Log into PawConnect"
                   wrapText="true"
                   maxWidth="350"
                   styleClass="login-form-title"/>

            <TextField fx:id="emailField"
                       prefWidth="360"
                       promptText="Email"/>

            <PasswordField fx:id="passwordField"
                           prefWidth="360"
                           promptText="Password"/>

            <TextField fx:id="displayNameField"
                       managed="false"
                       visible="false"
                       prefWidth="360"
                       promptText="Display name (register only)"/>

            <Button fx:id="btnLogin"
                    text="Login"
                    onAction="#onLogin"
                    prefWidth="360"
                    styleClass="login-main-button"/>

            <Button fx:id="btnRegister"
                    text="Create new account"
                    onAction="#onRegister"
                    prefWidth="360"
                    styleClass="login-outline-button"/>

            <Button fx:id="btnBackToLogin"
                    text="← Go Back"
                    onAction="#onBackToLogin"
                    managed="false"
                    visible="false"
                    prefWidth="360"
                    styleClass="login-outline-button"/>



            <Label fx:id="statusLabel"
                   text=""
                   wrapText="true"
                   styleClass="login-status"/>
        </VBox>
    </VBox>

</HBox>