<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>

<VBox fx:id="memoryRoot"
      spacing="0"
      alignment="TOP_CENTER"
      styleClass="memory-screen"
      stylesheets="@../styles/app.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.catconnect.controller.MemoryMatchController">

    <padding>
        <Insets top="18" right="28" bottom="30" left="28"/>
    </padding>

    <!-- =========================================================
         GAME HEADER
         ========================================================= -->

    <VBox maxWidth="820"
          alignment="TOP_CENTER"
          spacing="16"
          styleClass="memory-content">

        <!-- Small game category and titles grouped -->
        <VBox alignment="CENTER"
              spacing="4"
              styleClass="memory-header-box">

            <!-- Small game category -->
            <Label text="🐾  CATCONNECT  •  PLAYGROUND"
                   styleClass="memory-eyebrow"/>

            <!-- Main game title -->
            <Label text="Cat Memory Match"
                   styleClass="memory-title"/>

            <!-- Short description -->
            <Label text="Flip two cards, find the matching cats, and clear the board."
                   styleClass="memory-subtitle"
                   wrapText="true"/>

        </VBox>

        <!-- =====================================================
             GAME CONTROL ROW
             ===================================================== -->

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              maxWidth="820"
              styleClass="memory-control-row">

            <VBox alignment="CENTER_LEFT"
                  spacing="3"
                  HBox.hgrow="ALWAYS">

                <Label text="Find all the pairs"
                       styleClass="memory-section-title"/>

                <Label text="Take your time — every pair brings you closer to a purr-fect score."
                       styleClass="memory-section-subtitle"
                       wrapText="true"/>

            </VBox>

            <Button text="↻  New Game"
                    onAction="#onNewGame"
                    styleClass="memory-new-game"/>

        </HBox>


        <!-- =====================================================
             INVISIBLE DIFFICULTY CONTROLS
             
             Kept only because the existing Java controller
             expects these @FXML fields.
             They do NOT appear on screen.
             ===================================================== -->

        <HBox fx:id="difficultyContainer"
              visible="false"
              managed="false"
              opacity="0">

            <Button fx:id="btnEasy"
                    text="Easy (4×4)"
                    onAction="#onEasySelected"
                    styleClass="diff-btn, diff-btn-active"/>

            <Button fx:id="btnMedium"
                    text="Medium (5×4)"
                    onAction="#onMediumSelected"
                    styleClass="diff-btn"/>

            <Button fx:id="btnHard"
                    text="Hard (6×4)"
                    onAction="#onHardSelected"
                    styleClass="diff-btn"/>

        </HBox>


        <!-- =====================================================
             GAME STATS
             ===================================================== -->

        <HBox alignment="CENTER"
              spacing="12"
              maxWidth="820"
              styleClass="memory-stats">

            <!-- TIME -->
            <VBox alignment="CENTER"
                  spacing="3"
                  styleClass="memory-stat"
                  HBox.hgrow="ALWAYS">

                <Label text="TIME"
                       styleClass="memory-stat-label"/>

                <Label fx:id="timerLabel"
                       text="00:00"
                       styleClass="memory-stat-value"/>

            </VBox>


            <!-- MOVES -->
            <VBox alignment="CENTER"
                  spacing="3"
                  styleClass="memory-stat"
                  HBox.hgrow="ALWAYS">

                <Label text="MOVES"
                       styleClass="memory-stat-label"/>

                <Label fx:id="movesLabel"
                       text="0"
                       styleClass="memory-stat-value"/>

            </VBox>


            <!-- PAIRS -->
            <VBox alignment="CENTER"
                  spacing="3"
                  styleClass="memory-stat"
                  HBox.hgrow="ALWAYS">

                <Label text="PAIRS"
                       styleClass="memory-stat-label"/>

                <Label fx:id="matchesLabel"
                       text="0 / 8"
                       styleClass="memory-stat-value"/>

            </VBox>


            <!-- SCORE -->
            <VBox alignment="CENTER"
                  spacing="3"
                  styleClass="memory-stat memory-stat-highlight"
                  HBox.hgrow="ALWAYS">

                <Label text="SCORE"
                       styleClass="memory-stat-label"/>

                <Label fx:id="scoreLabel"
                       text="0"
                       styleClass="memory-stat-value"/>

            </VBox>


            <!-- BEST SCORE -->
            <VBox alignment="CENTER"
                  spacing="3"
                  styleClass="memory-stat memory-stat-secondary"
                  HBox.hgrow="ALWAYS">

                <Label text="BEST"
                       styleClass="memory-stat-label"/>

                <Label fx:id="bestScoreLabel"
                       text="--"
                       styleClass="memory-stat-small-value"/>

            </VBox>


            <!-- BEST TIME -->
            <VBox alignment="CENTER"
                  spacing="3"
                  styleClass="memory-stat memory-stat-secondary"
                  HBox.hgrow="ALWAYS">

                <Label text="BEST TIME"
                       styleClass="memory-stat-label"/>

                <Label fx:id="bestTimeLabel"
                       text="--"
                       styleClass="memory-stat-small-value"/>

            </VBox>

        </HBox>


        <!-- =====================================================
             MEMORY BOARD
             
             IMPORTANT:
             The actual cards are untouched.
             ===================================================== -->

        <StackPane fx:id="gameAreaStack"
                   alignment="CENTER"
                   maxWidth="820"
                   styleClass="memory-board">

            <GridPane fx:id="cardGrid"
                      alignment="CENTER"
                      hgap="12"
                      vgap="12"
                      styleClass="memory-grid-container"/>

            <Pane fx:id="overlayPane"
                  mouseTransparent="true"
                  pickOnBounds="false"/>

        </StackPane>

    </VBox>

</VBox>