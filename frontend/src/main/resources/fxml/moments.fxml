<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.catconnect.controller.MomentsController"
           stylesheets="@../styles/app.css" style="-fx-background-color: #ff6b6b;">

    <!-- Full-screen feed list -->
    <ListView fx:id="feedListView" style="-fx-background-color: #ff6b6b; -fx-padding: 0;"/>

    <!-- Top bar overlay -->
    <HBox alignment="TOP_RIGHT" spacing="10" pickOnBounds="false">
        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        <Button text="+ New Post" onAction="#onAdd"
                style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 6, 0, 0, 2);"/>
        <Button text="↻" onAction="#onRefresh"
                style="-fx-background-color: rgba(0,0,0,0.1); -fx-text-fill: #333333; -fx-font-size: 16px; -fx-background-radius: 20; -fx-min-width: 36; -fx-min-height: 36; -fx-cursor: hand;"/>
    </HBox>

    <Label fx:id="statusLabel" text="Loading posts..." style="-fx-text-fill: #666666; -fx-font-size: 14px;" StackPane.alignment="CENTER"/>

    <!-- Add Form Modal -->
    <StackPane fx:id="addFormOverlay" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false" managed="false">
        <VBox spacing="12" maxWidth="420" maxHeight="520" StackPane.alignment="CENTER"
              style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <HBox alignment="CENTER_LEFT">
                <Label text="New Cat Post" style="-fx-text-fill: #333333; -fx-font-size: 20px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="✕" onAction="#onCancelAdd" style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-size: 18px; -fx-cursor: hand;"/>
            </HBox>
            <Label text="Caption" style="-fx-text-fill: #555555; -fx-font-size: 13px;"/>
            <TextField fx:id="captionField" promptText="Write a caption..."
                       style="-fx-background-color: #ff6b6b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #dddddd; -fx-background-radius: 8; -fx-padding: 10;"/>
            <Label text="Media (Photo/Video)" style="-fx-text-fill: #555555; -fx-font-size: 13px;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Choose File..." onAction="#onChooseMedia"
                        style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
                <Button text="Clear" onAction="#onClearMedia"
                        style="-fx-background-color: #f0f0f0; -fx-text-fill: #555555; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;"/>
            </HBox>
            <Label fx:id="mediaLabel" text="No file selected" style="-fx-text-fill: #888888; -fx-font-size: 12px;"/>
            <Label text="Or paste Media URL" style="-fx-text-fill: #555555; -fx-font-size: 13px;"/>
            <TextField fx:id="mediaUrlField" promptText="https://..."
                       style="-fx-background-color: #ff6b6b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #dddddd; -fx-background-radius: 8; -fx-padding: 10;"/>
            <HBox spacing="12" style="-fx-padding: 12 0 0 0;">
                <Button text="Publish Post" onAction="#onSave"
                        style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 24; -fx-cursor: hand;"/>
                <Button text="Cancel" onAction="#onCancelAdd"
                        style="-fx-background-color: #f0f0f0; -fx-text-fill: #555555; -fx-background-radius: 10; -fx-padding: 10 24; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </StackPane>
    <!-- Crop Image Modal -->
    <StackPane fx:id="cropOverlay" style="-fx-background-color: rgba(0,0,0,0.85);" visible="false" managed="false">
        <VBox alignment="CENTER" spacing="20">
            <Label text="Drag to Crop" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <!-- The cropping area -->
            <StackPane fx:id="cropContainer" style="-fx-border-color: rgba(255,255,255,0.5); -fx-border-width: 2;">
                <!-- We will put a Pane inside this programmatically that contains the image -->
            </StackPane>
            <HBox alignment="CENTER" spacing="16">
                <Button text="Cancel" onAction="#onCancelCrop"
                        style="-fx-background-color: #555555; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10 24; -fx-cursor: hand;"/>
                <Button text="Done" onAction="#onConfirmCrop"
                        style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 10 24; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- Comments Panel (Instagram style - slides from right) -->
    <StackPane fx:id="commentsOverlay" style="-fx-background-color: rgba(0,0,0,0.5);" visible="false" managed="false">
        <VBox spacing="0" maxWidth="380" StackPane.alignment="CENTER_RIGHT"
              style="-fx-background-color: #ffffff; -fx-background-radius: 16 0 0 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, -2, 0);">
            <!-- Header -->
            <HBox alignment="CENTER" style="-fx-padding: 14 16; -fx-border-color: #eeeeee; -fx-border-width: 0 0 1 0;">
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Comments" style="-fx-text-fill: #333333; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#onCloseComments"
                        style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-font-size: 20px; -fx-cursor: hand;"/>
            </HBox>
            <!-- Comment list -->
            <ListView fx:id="commentsListView" VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff;"/>
            <!-- Input -->
            <HBox spacing="8" style="-fx-padding: 12 14; -fx-border-color: #eeeeee; -fx-border-width: 1 0 0 0;">
                <TextField fx:id="commentField" promptText="Add a comment..." HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #ff6b6b; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #dddddd; -fx-background-radius: 20; -fx-padding: 8 14;"/>
                <Button text="Post" onAction="#onPostComment"
                        style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
