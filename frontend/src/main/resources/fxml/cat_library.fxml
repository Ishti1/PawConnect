<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root"
            styleClass="cat-library-root"
            stylesheets="@../styles/app.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.catconnect.controller.CatLibraryController">

    <top>

        <VBox alignment="CENTER"
              spacing="5"
              styleClass="library-header">

            <padding>
                <Insets top="30"
                        right="30"
                        bottom="18"
                        left="30"/>
            </padding>

            <Label text="CAT LIBRARY"
                   styleClass="library-eyebrow"/>

            <Label text="Meet the many personalities of the feline world."
                   styleClass="library-title"/>

            <Label text="Explore breeds, characteristics and little facts about the cats we love."
                   styleClass="library-subtitle"
                   wrapText="true"/>

        </VBox>

    </top>


    <center>

        <VBox spacing="18"
              alignment="TOP_CENTER">

            <HBox alignment="CENTER"
                  spacing="12"
                  styleClass="library-search-row">

                <TextField fx:id="searchField"
                           promptText="Search breeds..."
                           styleClass="library-search"/>

                <Label fx:id="resultLabel"
                       text="8 breeds"
                       styleClass="library-result"/>

            </HBox>


            <ScrollPane fitToWidth="true"
                        fitToHeight="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="library-scroll">

                <FlowPane fx:id="breedGrid"
                          alignment="TOP_CENTER"
                          hgap="18"
                          vgap="18"
                          styleClass="breed-grid">

                    <padding>
                        <Insets top="5"
                                right="25"
                                bottom="35"
                                left="25"/>
                    </padding>

                </FlowPane>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>
