<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<VBox spacing="14" styleClass="screen-root" stylesheets="@../styles/app.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.catconnect.controller.VetsController">
    <padding><Insets top="4" right="2" bottom="16" left="2"/></padding>
    <Label fx:id="screenTitle" text="🏥 Nearby Veterinarians" styleClass="screen-title"/>
    <VBox styleClass="action-bar" spacing="10">
        <Label text="Add a vet listing. Only you can edit or delete your own posts." styleClass="action-bar-hint" wrapText="true"/>
        <HBox spacing="12"><Button text="+ Add Vet" onAction="#onAdd" styleClass="primary-button"/>
            <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/></HBox>
    </VBox>
    <VBox fx:id="addForm" styleClass="form-card" spacing="10" visible="false" managed="false">
        <Label text="Vet listing" styleClass="section-label"/>
        <Label text="Name (required)" styleClass="form-label"/><TextField fx:id="nameField"/>
        <Label text="Address" styleClass="form-label"/><TextField fx:id="addressField"/>
        <Label text="Phone" styleClass="form-label"/><TextField fx:id="phoneField"/>
        <Label text="Open hours" styleClass="form-label"/><TextField fx:id="hoursField"/>
        <Label text="City" styleClass="form-label"/><TextField fx:id="cityField"/>
        <CheckBox fx:id="emergencyBox" text="24/7 Emergency vet"/>
        <Label text="Photo (optional)" styleClass="form-label"/>
        <HBox spacing="10"><Button text="Choose photo..." onAction="#onChooseImage" styleClass="secondary-button"/>
            <Button text="Clear" onAction="#onClearImage" styleClass="secondary-button"/></HBox>
        <Label fx:id="photoLabel" text="No photo selected" styleClass="action-bar-hint"/>
        <ImageView fx:id="photoPreview" fitHeight="120" preserveRatio="true" styleClass="photo-preview"/>
        <TextField fx:id="imageUrlField" promptText="Or paste image URL (optional)"/>
        <HBox spacing="10"><Button text="Save" onAction="#onSave" styleClass="primary-button"/>
            <Button text="Cancel" onAction="#onCancelAdd" styleClass="secondary-button"/></HBox>
    </VBox>
    <Label fx:id="statusLabel" text="Loading..." styleClass="action-bar-hint"/>
    <VBox fx:id="listBox" spacing="10"/>
</VBox>
