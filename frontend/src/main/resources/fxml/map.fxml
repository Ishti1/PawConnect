<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.catconnect.controller.MapController"
      styleClass="screen-root"
      spacing="12"
      prefHeight="650"
      minHeight="600">

    <padding>
        <Insets top="0"
                right="0"
                bottom="0"
                left="0"/>
    </padding>

    <Label text="🗺 Paw Map"
           styleClass="screen-title"/>

    <Label fx:id="mapStatusLabel"
           text="Loading map..."
           style="-fx-text-fill: #636e72; -fx-font-size: 13px;"/>

    <WebView fx:id="mapWebView"
             minWidth="0"
             minHeight="0"
             prefWidth="1200"
             prefHeight="700"
             VBox.vgrow="ALWAYS"/>

</VBox>