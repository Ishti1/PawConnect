<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" styleClass="screen-root" stylesheets="@../styles/app.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.catconnect.controller.SheltersController">
    <padding><Insets top="4" right="2" bottom="16" left="2"/></padding>
    <!-- Location Bar -->
    <HBox alignment="CENTER_LEFT" style="-fx-background-color: #ffe3e3; -fx-padding: 8 16; -fx-background-radius: 20; -fx-border-color: #ff6b6b; -fx-border-radius: 20; -fx-border-width: 1;">
        <Label fx:id="userLocationLabel" text="📍 Loading location..." style="-fx-text-fill: #ff6b6b; -fx-font-weight: bold; -fx-font-size: 14px; -fx-font-family: 'Segoe UI', sans-serif;"/>
    </HBox>
    <Label fx:id="screenTitle" text="Shelter Directory" styleClass="screen-title"/>
    <VBox styleClass="search-header" spacing="12">
        <Label text="PawConnect" styleClass="brand-title"/>
        <HBox spacing="12">
            <TextField fx:id="searchField" promptText="Search shelters..." prefWidth="420"/>
            <ComboBox fx:id="locationBox" promptText="Location"/>
            <Button text="Search" onAction="#onSearch" styleClass="primary-button"/>
        </HBox>
    </VBox>

    <VBox fx:id="adminActionBar" styleClass="action-bar" spacing="10">
        <Label text="Admin controls: Add or manage shelters." styleClass="action-bar-hint" wrapText="true"/>
        <HBox spacing="12">
            <Button fx:id="addShelterButton" text="+ Add Shelter" onAction="#onAdd" styleClass="primary-button"/>
            <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
        </HBox>
    </VBox>

    <VBox fx:id="addForm" styleClass="form-card" spacing="10" visible="false" managed="false">
        <Label text="Shelter listing" styleClass="section-label"/>
        <Label text="Name (required)" styleClass="form-label"/><TextField fx:id="nameField"/>
        <Label text="Address" styleClass="form-label"/><TextField fx:id="addressField"/>
        <Label text="Phone" styleClass="form-label"/><TextField fx:id="phoneField"/>
        <Label text="Email" styleClass="form-label"/><TextField fx:id="emailField"/>
        <Label text="Description" styleClass="form-label"/><TextArea fx:id="descField" prefRowCount="3" wrapText="true"/>
        <Label text="Capacity" styleClass="form-label"/><TextField fx:id="capacityField"/>
        <Label text="City" styleClass="form-label"/><TextField fx:id="cityField"/>
        <Label text="Website link" styleClass="form-label"/><TextField fx:id="websiteField" promptText="https://example.com"/>
        <Label text="Photo (optional)" styleClass="form-label"/>
        <HBox spacing="10"><Button text="Choose photo..." onAction="#onChooseImage" styleClass="secondary-button"/>
            <Button text="Clear" onAction="#onClearImage" styleClass="secondary-button"/></HBox>
        <Label fx:id="photoLabel" text="No photo selected" styleClass="action-bar-hint"/>
        <ImageView fx:id="photoPreview" fitHeight="120" preserveRatio="true" styleClass="photo-preview"/>
        <TextField fx:id="imageUrlField" promptText="Or paste image URL (optional)"/>
        <HBox spacing="10"><Button text="Save" onAction="#onSave" styleClass="primary-button"/>
            <Button text="Cancel" onAction="#onCancelAdd" styleClass="secondary-button"/></HBox>
    </VBox>
    <Label text="All Shelters" styleClass="section-label"/>

    <Label fx:id="statusLabel" text="Loading..." styleClass="action-bar-hint"/>

    <TilePane fx:id="listBox"
              prefColumns="2"
              hgap="20"
              vgap="20"
              prefTileWidth="480"
              tileAlignment="TOP_LEFT"/>
</VBox>
