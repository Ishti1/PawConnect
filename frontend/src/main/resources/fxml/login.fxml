<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="login-pane" stylesheets="@../styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.catconnect.controller.LoginController">
    <VBox alignment="CENTER" maxWidth="420" spacing="20" styleClass="login-card">
        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" text="🐱 PaWHuB" />
        <Label style="-fx-text-fill: #636e72;" text="Your community for cats" />
        <TextField fx:id="emailField" prefWidth="320" promptText="Email" />
        <PasswordField fx:id="passwordField" prefWidth="320" promptText="Password" />
        <TextField fx:id="displayNameField" managed="false" prefWidth="320" promptText="Display name (register only)" visible="false" />
        <HBox alignment="CENTER" spacing="12">
            <Button onAction="#onLogin" prefWidth="150" styleClass="primary-button" text="Login" />
            <Button onAction="#onRegister" prefWidth="150" style="-fx-background-color: #dfe6e9; -fx-background-radius: 6; -fx-padding: 10 20;" text="Register" />
        </HBox>
        <Label fx:id="statusLabel" style="-fx-text-fill: #636e72; -fx-font-size: 11px;" text="Starting..." wrapText="true" />
    </VBox>
</StackPane>
